+/* Copies up to max records with a sequence number of from or more (oldest first) and returns how many; *newest is the newest
+ * sequence number handed out.
+ */
+extern "C" __attribute__((visibility("default"))) uint32_t tu_pass_ring_read(uint32_t from, struct tu_pass_rec *out, uint32_t max,
+                                                                            uint32_t *newest);
+extern "C" __attribute__((visibility("default"))) uint32_t
+tu_pass_ring_read(uint32_t from, struct tu_pass_rec *out, uint32_t max, uint32_t *newest)
+{
+   const uint32_t last = p_atomic_read(&tu_pass_seq);
+   *newest = last;
+   uint32_t first = from ? from : 1;
+   if (first > last)
+      return 0;
+   if (last - first >= 512)
+      first = last - 511;
+   uint32_t n = 0;
+   for (uint32_t s = first; s <= last && n < max; s++) {
+      struct tu_pass_rec rec = tu_pass_ring[s % 512];
+      if (rec.seq != s)
+         continue;
+      struct tu_bo *bo = p_atomic_read(&tu_pass_ts_bo);
+      if (bo) {
+         const volatile uint64_t *words = (const volatile uint64_t *) bo->map + (s % 512) * 2;
+         const uint64_t begin = words[0], end = words[1];
+         if (begin && end) {
+            rec.gpu_begin = tu_device_ticks_to_ns(tu_pass_ts_dev, begin);
+            rec.gpu_end = tu_device_ticks_to_ns(tu_pass_ts_dev, end);
+         }
+      }
+      out[n++] = rec;
+   }
+   return n;
