@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#ifdef __APPLE__
+extern "C" bool tu_darwin_frame_diagnostic(uint32_t,const void *,uint32_t);
+static inline void tu_frame_event(uint32_t event,uint64_t a=0,uint64_t b=0,uint64_t c=0,uint64_t d=0,uint64_t e=0,uint64_t f=0,uint64_t g=0,uint64_t h=0,uint64_t i=0,uint64_t j=0,uint64_t k=0,uint64_t l=0) {
+   static const bool on=getenv("SHENG_GPU_TRACE")!=nullptr;
+   if(!on || event)return;
+   /* Pass and submission records stay in this process's rings (frames.trace); none reach the kernel ring. */
+   struct {uint64_t seq,us;uint32_t event,pid;uint64_t v[12];} rec={0,0,event,0,{a,b,c,d,e,f,g,h,i,j,k,l}};
+   (void)tu_darwin_frame_diagnostic(0x7102,&rec,sizeof(rec));
+}
+#else
+static inline void tu_frame_event(uint32_t,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0,uint64_t=0) {}
+#endif
diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
new file mode 100644
--- /dev/null
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -0,0 +1,1769 @@
+#include "tu_frame_diagnostic.h"
+/*
+ * Native Darwin kernel backend for Turnip: talks to the NativeAdreno IOKit user client (NativeAdrenoABI.h, version 1).
+ * Modelled on tu_knl_kgsl.cc (no libdrm) and tu_knl_drm_msm.cc (the client chooses GPU addresses).
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+#include <dispatch/dispatch.h>
+#include <mach/mach.h>
+
+#include "NativeAdrenoABI.h"
+
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include "util/rb_tree.h"
+#include "util/timespec.h"
+#include "util/u_debug.h"
+#include "util/u_vector.h"
+#include "vk_util.h"
+
+#include "tu_cmd_buffer.h"
+#include "tu_cs.h"
+#include "tu_device.h"
+#include "tu_dynamic_rendering.h"
+#include "tu_knl.h"
+#include "tu_queue.h"
+#include "tu_rmv.h"
+
+/* 'NTNL': first word of a tunnelled call, as served by the driver (NativeAdrenoPublish.cpp). */
+#define DW_TUNNEL_MAGIC 0x4e544e4cu
+
+/* One GPU per process: the kernel service has a single connection slot, so the connection and the fence bookkeeping are
+ * process state rather than per tu_device state. */
+static struct {
+   io_connect_t conn;
+   bool open;
+   pthread_mutex_t lock;
+   /* Fences of the submissions still possibly in flight, oldest first (the kernel keeps at most eight jobs). */
+   uint32_t inflight[8];
+   unsigned inflight_count;
+   /* Transport. On the tablet a sandboxed process (the Metal plugin inside SpringBoard) reaches the driver through the AGX accelerator
+    * service with open type 0x4147, and the sandbox profile decides which external-method selector numbers are admitted, so every ABI
+    * method travels as {magic, method, payload} through one admitted selector (the same tunnel the plugin's own test uses). Direct
+    * selectors (selector = ABI method) stay available for an unrestricted process that opens NativeAdrenoGpuPublished. */
+   bool tunnel;
+   uint32_t selector;
+   uint32_t last_fence;
+   NativeAdrenoAbiDeviceInfo info;
+   NativeAdrenoAbiParams params;
+} dw = { .lock = PTHREAD_MUTEX_INITIALIZER };
+
+/* Preserve the native handle, CPU view and IOVA until the captured ring fence
+ * actually completed. An unrelated later submission never extends this lease.
+ * The queue grows with what is waiting; destruction never waits. */
+struct darwin_retired_bo {
+   uint64_t handle, iova, size;
+   void *mapping;
+   uint32_t token, fence;
+   bool cacheable, read_only;
+};
+
+/* A freed BO whose fence completed stays whole (kernel handle, GPU mapping, CPU lease) in a size-class cache and is handed to the next
+ * allocation of its class: one BoAlloc + BoMap (the SMMU table update, about a millisecond) and one BoFree + unmap saved per reuse.
+ * Classes are the size rounded up to a quarter of its power of two (4 KiB steps up to 16 KiB). Replayable BOs (client addresses) and
+ * host imports never enter it. */
+/* No byte or entry limit: as Metal's own resource cache does, the cache gives everything back when the system reports memory pressure
+ * (DISPATCH_SOURCE_TYPE_MEMORYPRESSURE, warning or critical, the signal Apple's frameworks purge on) and when an allocation or a GPU range
+ * cannot be had (then the allocation is tried again). */
+static volatile uint32_t darwin_memory_pressure;   /* bumped by the memory-pressure source; each device flushes once per change */
+struct darwin_cached_bo {
+   uint64_t handle, iova, size, stamp, freed_s;   /* freed_s: monotonic seconds when it entered the cache */
+   void *mapping;
+   uint32_t token;
+   bool read_only;
+};
+struct darwin_bo_cache_stats {
+   uint64_t lookups, hits, inserts, evictions, flushes, bytes_peak;
+};
+
+/* The GPU address space as two red-black trees over the free holes (Mesa's rb_tree, the same algorithm as XNU's libkern/tree.h): by
+ * address, to find a hole's neighbours when a range is freed and merge them, and by (size, address), to find the smallest hole that
+ * fits an allocation. Allocation, free and merge are all O(log n) in the number of holes; the heap it replaces (a list of holes) was
+ * walked from its head on every free and every allocation. */
+struct darwin_va_hole {
+   struct rb_node by_address, by_size;
+   uint64_t start, size;
+};
+struct darwin_va {
+   struct rb_tree address, size;
+   bool seeded;
+   uint64_t holes, allocs, frees, merges;
+   uint64_t used;   /* bytes handed out */
+};
+
+struct darwin_retire_state {
+   pthread_mutex_t lock;
+   struct darwin_retired_bo *entries;   /* a ring of `capacity` records, grown when full */
+   unsigned capacity, head, count;
+   VkResult failure;
+   uint64_t enqueued, reaped, pressure_waits;
+   struct darwin_cached_bo *cache;
+   unsigned cache_count, cache_capacity;
+   uint64_t cache_bytes, cache_stamp, cache_cleaned_s;
+   uint32_t pressure_seen;
+   struct darwin_bo_cache_stats cache_stats;
+   struct darwin_va va;
+};
+static struct darwin_retire_state *darwin_stats_state;   /* for tu_darwin_bo_cache_stats */
+
+extern "C" __attribute__((visibility("default"))) void tu_darwin_bo_cache_stats(uint64_t out[8]);
+extern "C" __attribute__((visibility("default"))) void
+tu_darwin_bo_cache_stats(uint64_t out[8])
+{
+   struct darwin_retire_state *retire = darwin_stats_state;
+   memset(out, 0, 8 * sizeof(uint64_t));
+   if (!retire)
+      return;
+   pthread_mutex_lock(&retire->lock);
+   out[0] = retire->cache_stats.lookups;
+   out[1] = retire->cache_stats.hits;
+   out[2] = retire->cache_stats.inserts;
+   out[3] = retire->cache_stats.evictions;
+   out[4] = retire->cache_stats.flushes;
+   out[5] = retire->cache_bytes;
+   out[6] = retire->cache_stats.bytes_peak;
+   out[7] = retire->va.holes;
+   pthread_mutex_unlock(&retire->lock);
+}
+
+/* The priority the driver was last given for this process (NativeAdrenoMethodSetPriority). */
+static NativeAdrenoAbiPriority dw_priority;
+static bool dw_priority_known;
+
+static kern_return_t
+dw_call(uint32_t method, const void *in, size_t in_size, void *out,
+        size_t out_size)
+{
+   size_t out_bytes = out_size;
+   if (!dw.tunnel)
+      return IOConnectCallStructMethod(dw.conn, method, in, in_size, out_size ? out : NULL,
+                                       out_size ? &out_bytes : NULL);
+   uint8_t buffer[8 + sizeof(NativeAdrenoAbiSubmit)];
+   if (in_size > sizeof(NativeAdrenoAbiSubmit))
+      return kIOReturnBadArgument;
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, method};
+   memcpy(buffer, header, sizeof(header));
+   if (in_size)
+      memcpy(buffer + sizeof(header), in, in_size);
+   return IOConnectCallStructMethod(dw.conn, dw.selector, buffer, sizeof(header) + in_size, out_size ? out : NULL,
+                                    out_size ? &out_bytes : NULL);
+}
+
+/* Finds an admitted selector: the driver answers a tunnel probe (method 0xffffffff) with success for every selector the sandbox lets through. */
+static bool
+dw_probe_selector(void)
+{
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, 0xffffffffu};
+   for (uint32_t s = 0; s < 256; s++) {
+      if (IOConnectCallStructMethod(dw.conn, s, header, sizeof(header), NULL, NULL) == KERN_SUCCESS) {
+         dw.selector = s;
+         return true;
+      }
+   }
+   return false;
+}
+
+static VkResult
+dw_open_connection(struct tu_instance *instance)
+{
+   /* TU_DARWIN_SERVICE names the IOKit service (default: the AGX accelerator the original Metal discovery finds), TU_DARWIN_OPEN_TYPE its open
+    * type (default 0x4147, the type the driver serves to the plugin). NativeAdrenoGpuPublished with type 0 is the unsandboxed direct form. */
+   const char *service_name = getenv("TU_DARWIN_SERVICE");
+   if (!service_name || !*service_name)
+      service_name = "IOAcceleratorES";
+   const char *type_text = getenv("TU_DARWIN_OPEN_TYPE");
+   uint32_t open_type = type_text && *type_text ? (uint32_t)strtoul(type_text, NULL, 0) : 0x4147u;
+   const bool direct = !strcmp(service_name, "NativeAdrenoGpuPublished");
+   if (direct && !(type_text && *type_text))
+      open_type = 0;
+   io_service_t service = IOServiceGetMatchingService(
+      kIOMainPortDefault, IOServiceMatching(service_name));
+   if (!service)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   kern_return_t kr = IOServiceOpen(service, mach_task_self(), open_type, &dw.conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS) {
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                               "IOServiceOpen(%s, 0x%x) failed: 0x%x", service_name, open_type, kr);
+   }
+   dw.tunnel = !direct;
+   if (dw.tunnel && !dw_probe_selector()) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "no external-method selector is admitted for this process");
+   }
+
+   kr = dw_call(NativeAdrenoMethodQuery, NULL, 0, &dw.params, sizeof(dw.params));
+   if (kr == KERN_SUCCESS && dw.params.abi_version != NativeAdrenoAbiVersion)
+      kr = kIOReturnUnsupported;
+   if (kr == KERN_SUCCESS)
+      kr = dw_call(NativeAdrenoMethodGetDeviceInfo, NULL, 0, &dw.info, sizeof(dw.info));
+   if (kr != KERN_SUCCESS) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                               "NativeAdreno query failed: 0x%x", kr);
+   }
+   dw.open = true;
+   dw.inflight_count = 0;
+   dw.last_fence = 0;
+
+   /* Normal until Metal queues publish their current requests. An explicit environment override is also accepted. */
+   {
+      const char *want = getenv("METAL2VULKAN_QUEUE_PRIORITY");
+      NativeAdrenoAbiPriority priority = {.foreground = 1, .background = 3};
+      if (want && !strcmp(want, "high")) {
+         priority.foreground = 0;
+         priority.background = 2;
+      } else if (want && !strcmp(want, "low")) {
+         priority.foreground = 2;
+         priority.background = 2;
+      }
+      dw_priority = priority;
+      dw_priority_known = true;
+      (void)dw_call(NativeAdrenoMethodSetPriority, &priority, sizeof(priority), NULL, 0);
+   }
+   return VK_SUCCESS;
+}
+
+/* What the process's own Metal queues ask for (the frontend's setGPUPriority: and setBackgroundGPUPriority:), given to the driver as they
+ * come: the runtime sent the board's default at device open, before the process could ask. 0xffffffff keeps that value. False before the
+ * device is open or when the driver refuses it (a foreground priority of 3, the disabled level, is not a queue's foreground).
+ */
+extern "C" __attribute__((visibility("default"))) bool tu_darwin_set_priority(uint32_t foreground, uint32_t background);
+extern "C" __attribute__((visibility("default"))) bool
+tu_darwin_set_priority(uint32_t foreground, uint32_t background)
+{
+   if ((foreground != UINT32_MAX && (foreground > 5 || foreground == 3)) ||
+       (background != UINT32_MAX && background > 5))
+      return false;
+   pthread_mutex_lock(&dw.lock);
+   bool accepted = false;
+   if (dw_priority_known && dw.open) {
+      NativeAdrenoAbiPriority priority = dw_priority;
+      if (foreground != UINT32_MAX) priority.foreground = foreground;
+      if (background != UINT32_MAX) priority.background = background;
+      /* The frontend aggregates current live queues; lowering releases an old boost. */
+      accepted = (priority.foreground == dw_priority.foreground && priority.background == dw_priority.background) ||
+         dw_call(NativeAdrenoMethodSetPriority, &priority, sizeof(priority), NULL, 0) == KERN_SUCCESS;
+      if (accepted) dw_priority = priority;
+   }
+   pthread_mutex_unlock(&dw.lock);
+   return accepted;
+}
+
+/* A note for the kernel's log (NativeAdrenoMethodNote), from the host frontend: kind 1 a render pass, 2 a pipeline made or refused. The
+ * kernel adds the caller's pid. False before the device is open or when the driver refuses it.
+ */
+extern "C" __attribute__((visibility("default"))) bool tu_darwin_note(uint32_t kind, const uint32_t *words, uint32_t count);
+extern "C" __attribute__((visibility("default"))) bool
+tu_darwin_note(uint32_t kind, const uint32_t *words, uint32_t count)
+{
+   if (!dw.open || count > NativeAdrenoNoteWords)
+      return false;
+   NativeAdrenoAbiNote note = {};
+   note.kind = kind;
+   note.count = count;
+   memcpy(note.words, words, count * sizeof(uint32_t));
+   return dw_call(NativeAdrenoMethodNote, &note, sizeof(note), NULL, 0) == KERN_SUCCESS;
+}
+
+extern "C" __attribute__((visibility("default"))) const char *tu_darwin_frame_build_id(void);
+extern "C" __attribute__((visibility("default"))) const char *tu_darwin_frame_build_id(void) {
+#ifdef TU_BUILD_ID_OVERRIDE
+   return TU_BUILD_ID_OVERRIDE;
+#else
+   return "unknown";
+#endif
+}
+
+extern "C" __attribute__((visibility("default"))) bool
+tu_darwin_frame_diagnostic(uint32_t method,const void *data,uint32_t bytes)
+{
+   if(!dw.open || !data || method!=0x7102 ||
+      bytes!=120)return false;
+   return dw_call(method,data,bytes,NULL,0)==KERN_SUCCESS;
+}
+
+static void
+dw_close_connection(void)
+{
+   if (dw.open) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      dw.open = false;
+   }
+}
+
+static VkResult
+dw_status_to_vk(struct tu_device *dev, kern_return_t kr, const char *what)
+{
+   if (kr == KERN_SUCCESS)
+      return VK_SUCCESS;
+   if (kr == kIOReturnTimeout)
+      return VK_TIMEOUT;
+   return vk_device_set_lost(&dev->vk, "%s failed: 0x%x", what, kr);
+}
+
+/* Waits for a fence in short kernel waits so the connection lock is never held for long. */
+static VkResult
+dw_wait_fence_raw(struct tu_device *dev, uint32_t fence, uint64_t abs_timeout_ns)
+{
+   for (;;) {
+      uint64_t now = os_time_get_nano();
+      /* The rest of the wait, at most 100 ms a call: the kernel sleeps between fence interrupts until the fence or the
+       * timeout. One 1 ms slice a call made a frame's wait several IOKit calls (i553: 258682 waits in 166 s, 97 % timed out). */
+      uint64_t slice = 100000000; /* 100 ms */
+      if (abs_timeout_ns != UINT64_MAX)
+         slice = abs_timeout_ns > now ? MIN2(abs_timeout_ns - now, slice) : 0;
+      NativeAdrenoAbiWaitFence req = {.fence = fence, .timeout_ns = slice};
+      kern_return_t kr = dw_call(NativeAdrenoMethodWaitFence, &req, sizeof(req), NULL, 0);
+      if (kr == KERN_SUCCESS)
+         return VK_SUCCESS;
+      if (kr != kIOReturnTimeout)
+         return dw_status_to_vk(dev, kr, "wait fence");
+      if (slice == 0)
+         return VK_TIMEOUT;
+      if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
+         return VK_TIMEOUT;
+   }
+}
+
+static VkResult darwin_collect_retired(struct tu_device *dev);
+
+static VkResult
+dw_wait_fence_locked_free(struct tu_device *dev, uint32_t fence, uint64_t abs_timeout_ns)
+{
+   VkResult result = dw_wait_fence_raw(dev, fence, abs_timeout_ns);
+   /* Fence observation is also a retirement opportunity, so a quiet application
+    * need not allocate another BO to release completed deferred storage. */
+   return result == VK_SUCCESS ? darwin_collect_retired(dev) : result;
+}
+
+static VkResult
+darwin_queue_wait_fence(struct tu_queue *queue, uint32_t fence, uint64_t timeout_ns)
+{
+   uint64_t abs = timeout_ns == UINT64_MAX ? UINT64_MAX : os_time_get_nano() + timeout_ns;
+   return dw_wait_fence_locked_free(queue->device, fence, abs);
+}
