--- a/osfmk/kern/waitq.c
+++ b/osfmk/kern/waitq.c
@@ -2372,32 +2372,62 @@
 
 	/* waitq is unlocked upon return, splx is handled */
 	return waitq_wakeup64_one_locked(waitq, wake_event, result,
 	           flags | waitq_flags_splx(spl) | WAITQ_UNLOCK);
