+/*
+ * sheng: what each CPU was doing the last time it masked interrupts, and what its interrupt
+ * path looked like at that moment.
+ *
+ * A core that never takes an interrupt again is one of three things, and they need different
+ * fixes: it sits inside one masked section for good (site and count both frozen), it runs
+ * masked code in a loop (count still climbing), or it stops masking and the interrupt is
+ * withheld below the kernel. splhigh(), splsched() and splclock() are macros over this
+ * function, so `site` is the address of the code that asked for the mask, not a wrapper.
+ *
+ * The four system registers only the core itself can read answer the second half: with
+ * ICC_IGRPEN1 clear the CPU interface forwards nothing; with ICC_PMR lower than the timer's
+ * priority nothing is signalled; ICC_HPPIR1 names the highest Group 1 interrupt the interface
+ * is holding, so 27 proves the timer reached it; and CNTV_CTL with CNTV_CVAL says whether a
+ * wakeup was armed at all and how far away it was. `stamp` is in timebase ticks, so a healthy
+ * core can report how long the victim has been masked.
+ *
+ * `masked` counts only calls that changed the state, so a thread that spams splx() on an
+ * already-enabled CPU does not move it. Indexed by CPU number, written by the owning CPU
+ * only, read by the board package. No kernel code reads it, so a wrong value here cannot
+ * change a decision.
+ */
+volatile uint64_t sheng_irq_mask_site[8];
+volatile uint64_t sheng_irq_mask_count[8];
+volatile uint64_t sheng_irq_unmask_count[8];
+volatile uint64_t sheng_irq_mask_thread[8];
+volatile uint64_t sheng_irq_mask_stamp[8];
+volatile uint64_t sheng_irq_igrpen1[8];
+volatile uint64_t sheng_irq_pmr[8];
+volatile uint64_t sheng_irq_hppir1[8];
+volatile uint64_t sheng_irq_cntv_ctl[8];
+volatile int64_t  sheng_irq_cntv_rem[8];
+
 boolean_t
 ml_set_interrupts_enabled(boolean_t enable)
 {
+	const uint32_t sheng_cpu = (uint32_t)cpu_number();
+	if (sheng_cpu < 8) {
+		const uint64_t sheng_daif = __builtin_arm_rsr("DAIF");
+		if (!enable && (sheng_daif & DAIF_IRQF) == 0) {
+			uint64_t sheng_cval, sheng_now;
+			thread_t sheng_thread = current_thread();
+			__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r" (sheng_now));
+			sheng_irq_mask_site[sheng_cpu] = (uint64_t)(uintptr_t)__builtin_return_address(0);
+			sheng_irq_mask_count[sheng_cpu] = sheng_irq_mask_count[sheng_cpu] + 1;
+			sheng_irq_mask_thread[sheng_cpu] = sheng_thread ? (uint64_t)thread_tid(sheng_thread) : 0;
+			sheng_irq_mask_stamp[sheng_cpu] = sheng_now;
+			__asm__ volatile ("mrs %0, icc_igrpen1_el1" : "=r" (sheng_irq_igrpen1[sheng_cpu]));
+			__asm__ volatile ("mrs %0, icc_pmr_el1" : "=r" (sheng_irq_pmr[sheng_cpu]));
+			__asm__ volatile ("mrs %0, icc_hppir1_el1" : "=r" (sheng_irq_hppir1[sheng_cpu]));
+			__asm__ volatile ("mrs %0, cntv_ctl_el0" : "=r" (sheng_irq_cntv_ctl[sheng_cpu]));
+			__asm__ volatile ("mrs %0, cntv_cval_el0" : "=r" (sheng_cval));
+			sheng_irq_cntv_rem[sheng_cpu] = (int64_t)(sheng_cval - sheng_now);
+		} else if (enable && (sheng_daif & DAIF_IRQF) != 0) {
+			sheng_irq_unmask_count[sheng_cpu] = sheng_irq_unmask_count[sheng_cpu] + 1;
+		}
+	}
 	return ml_set_interrupts_enabled_with_debug(enable, true);
 }
 
