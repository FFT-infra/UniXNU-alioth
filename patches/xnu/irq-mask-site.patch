--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1066,9 +1066,69 @@
 	return (state & DAIF_IRQF) == 0;
 }
 
+/*
+ * sheng: the mask sites each CPU passed through, newest last, plus the arch timer as that CPU
+ * last saw it.
+ *
+ * A core that stops taking interrupts stops advancing the counter, so the newest ring entry is
+ * the function it entered when it stopped and the entries behind it are the descent that led
+ * there. splhigh(), splsched() and splclock() are macros over this function, so each entry names
+ * the code that asked for the mask rather than a wrapper.
+ *
+ * The timer words beside it answer the other half: whether the deadline this CPU was waiting on
+ * had already passed when it went quiet. ctl bit 0 is ENABLE, bit 1 IMASK, bit 2 ISTATUS; rem is
+ * cval minus the counter at that moment, so a negative rem with ISTATUS set means the interrupt
+ * was raised and not delivered, and a positive one means the CPU was waiting for a later deadline.
+ *
+ * Counters are incremented on every mask and every unmask, and the two do not have to agree:
+ * machine_idle() clears DAIF itself, which this function never sees. In 8 KiB pages the ring is
+ * written by the owning CPU only and read by the board package; no kernel code reads it, so a
+ * wrong value here cannot change a decision.
+ */
+enum { SHENG_MASK_RING = 8 };
+volatile uint64_t sheng_irq_ring_site[8][SHENG_MASK_RING];
+volatile uint64_t sheng_irq_ring_caller[8][SHENG_MASK_RING];
+volatile uint64_t sheng_irq_ring_thread[8][SHENG_MASK_RING];
+volatile uint64_t sheng_irq_mask_count[8];
+volatile uint64_t sheng_irq_unmask_count[8];
+volatile uint64_t sheng_irq_ring_cntv_ctl[8];
+volatile int64_t  sheng_irq_ring_cntv_rem[8];
+
 boolean_t
 ml_set_interrupts_enabled(boolean_t enable)
 {
+	const uint32_t sheng_cpu = (uint32_t)cpu_number();
+	if (sheng_cpu < 8) {
+		const uint64_t sheng_daif = __builtin_arm_rsr("DAIF");
+		if (!enable && (sheng_daif & DAIF_IRQF) == 0) {
+			uint64_t sheng_now, sheng_cval, sheng_fp;
+			thread_t sheng_thread = current_thread();
+			const uint64_t sheng_n = sheng_irq_mask_count[sheng_cpu];
+			const uint32_t sheng_slot = (uint32_t)(sheng_n & (SHENG_MASK_RING - 1));
+			__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r" (sheng_now));
+			__asm__ volatile ("mov %0, x29" : "=r" (sheng_fp));
+			sheng_irq_mask_count[sheng_cpu] = sheng_n + 1;
+			sheng_irq_ring_site[sheng_cpu][sheng_slot] = (uint64_t)(uintptr_t)__builtin_return_address(0);
+			sheng_irq_ring_caller[sheng_cpu][sheng_slot] = 0;
+			sheng_irq_ring_thread[sheng_cpu][sheng_slot] = sheng_thread ? (uint64_t)thread_tid(sheng_thread) : 0;
+			__asm__ volatile ("mrs %0, cntv_ctl_el0" : "=r" (sheng_irq_ring_cntv_ctl[sheng_cpu]));
+			__asm__ volatile ("mrs %0, cntv_cval_el0" : "=r" (sheng_cval));
+			sheng_irq_ring_cntv_rem[sheng_cpu] = (int64_t)(sheng_cval - sheng_now);
+			/* A frame record is {next, return address}, and the next one out is read only while
+			 * it points into this thread's own kernel stack, so a corrupt frame cannot send this
+			 * read anywhere. */
+			if (sheng_thread && sheng_thread->kernel_stack) {
+				const uint64_t sheng_low = (uint64_t)sheng_thread->kernel_stack;
+				const uint64_t sheng_high = sheng_low + (uint64_t)kernel_stack_size;
+				if (sheng_fp >= sheng_low && sheng_fp + 16 <= sheng_high && !(sheng_fp & 15) &&
+				    *(const uint64_t *)sheng_fp >= sheng_low && *(const uint64_t *)sheng_fp + 16 <= sheng_high) {
+					sheng_irq_ring_caller[sheng_cpu][sheng_slot] = *(const uint64_t *)(*(const uint64_t *)sheng_fp + 8);
+				}
+			}
+		} else if (enable && (sheng_daif & DAIF_IRQF) != 0) {
+			sheng_irq_unmask_count[sheng_cpu] = sheng_irq_unmask_count[sheng_cpu] + 1;
+		}
+	}
 	return ml_set_interrupts_enabled_with_debug(enable, true);
 }
 
