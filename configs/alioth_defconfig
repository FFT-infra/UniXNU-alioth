# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# SM8250 (kona) implements ARMv8.1 PAN: copyin/copyout must manage it at the exception entry.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_SHENG_PMGR=y
# Without this, check_for_panic_log() takes the #ifdef PLATFORM_PANIC_LOG_PADDR branch: the
# BCM2837 board header is the one board_config.h includes for this target, so it hardcodes
# 0x3c0fc000, an address in the Raspberry Pi's peripheral space. On SM8250 that mapping is
# unmapped device space, and PE_create_console() dereferences it as an embedded_panic_header
# with the MMU already on and no exception vectors installed, which hangs the boot CPU.
# With the flag set, native-dt-panic-region.patch reads the region from the ADT instead, and a
# DT with no pram node makes the function return without mapping anything.
CONFIG_XNU_DT_PANIC_REGION=y
# Owner-verified root publication. Without this the UFS driver compiles as a probe-only
# transport (-DNATIVE_UFS_PROBE_ONLY=1): start() brings the link up but publishes no
# IOMedia, so IOFindBSDRoot waits ROOTDEVICETIMEOUT ten times and panics. Turning it on
# selects -DNATIVE_VERIFIED_BLOCK=1 and force-loads libVerifiedRootProbe.a, whose signed
# hash table and key come from the unchanged original OS image.
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
# The A650 GPU path is not provided by a catalog component yet.
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
