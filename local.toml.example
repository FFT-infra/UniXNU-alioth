# Optional development overrides; leave local.toml absent for pinned builds.
# Copy this file to local.toml (ignored by Git) to resolve a source from a local
# checkout instead of feeds.toml and unixnu.lock. The command line
# (--local-module, --local-drivers, ...) takes precedence over this file.

# One entry per source that should come from a local checkout.
# [[source]]
# name = "ShengUfs"
# kind = "driver"
# local = "../NativeUfs-alioth"

[local]
drivers = "../UniXNU-alioth/drivers"
